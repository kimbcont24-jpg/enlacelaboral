// Publicación TEMPORAL en Cloudflare Workers (desde el 25 nov 2026), mientras la cuenta de Vercel está en pausa.
// Cloudflare construye con `npm run build` y publica con `npx wrangler deploy` usando este archivo.
// Vercel ignora este archivo: para volver a Vercel no hay que borrarlo.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enlacelaboral",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": { "binding": "ASSETS", "directory": ".output/public" },
  "observability": { "enabled": true }
}
